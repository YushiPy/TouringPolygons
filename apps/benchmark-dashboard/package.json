{
	"name": "tpp-benchmark-dashboard-tests",
	"private": true,
	"type": "module",
	"scripts": {
		"start:event": ".venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8017",
		"start:event:lan": ".venv/bin/python -m uvicorn event_server:app --host 0.0.0.0 --port 8019",
		"test:event": ".venv/bin/python -m unittest discover -s tests -p test_event.py && node --test tests/event-geometry.test.mjs",
		"test:all": "scripts/run-tests.sh",
		"test:browser:free": "node tests/free-order-smoke.mjs",
		"test:browser": "node tests/browser_smoke.mjs",
		"check:js": "for file in static/*.js; do node --check \"$file\"; done",
		"lint:js": "eslint static tests"
	},
	"devDependencies": {
		"@playwright/test": "^1.52.0",
		"eslint": "^9.0.0"
	}
}
