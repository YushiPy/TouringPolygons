+::Vector2 to_tpp_point(const Point &point) {
+  return {point.get<0>(), point.get<1>()};
+}
+
+double cross(const ::Vector2 &origin, const ::Vector2 &a,
+             const ::Vector2 &b) {
+  return (a - origin).cross(b - origin);
+}
+
+std::vector<::Vector2>
+normalize_convex_polygon(std::vector<::Vector2> points) {
+  std::ranges::sort(points, {}, [](const auto &point) {
+    return std::pair{point.x, point.y};
+  });
+  const auto unique_end = std::ranges::unique(points, {}, [](const auto &point) {
+                            return std::pair{point.x, point.y};
+                          }).begin();
+  points.erase(unique_end, points.end());
+  if (points.size() <= 2) {
+    return points;
+  }
+  std::vector<::Vector2> hull;
+  hull.reserve(points.size() * 2);
+  for (const auto point : points) {
+    while (hull.size() >= 2 &&
+           cross(hull[hull.size() - 2], hull.back(), point) <= 0) {
+      hull.pop_back();
+    }
+    hull.push_back(point);
+  }
+  const auto lower_size = hull.size();
+  for (auto iterator = points.rbegin() + 1; iterator != points.rend();
+       ++iterator) {
+    while (hull.size() > lower_size &&
+           cross(hull[hull.size() - 2], hull.back(), *iterator) <= 0) {
+      hull.pop_back();
+    }
+    hull.push_back(*iterator);
+  }
+  hull.pop_back();
+  return hull;
+}
+
+std::vector<::Vector2> to_tpp_polygon(const SiteVariant &site) {
+  std::vector<::Vector2> result;
+  auto append_ring = [&](const auto &ring) {
+    result.reserve(ring.size());
+    for (const auto &point : ring) {
+      if (!result.empty() && point.template get<0>() == result.front().x &&
+          point.template get<1>() == result.front().y && &point == &ring.back()) {
+        continue;
+      }
+      result.push_back(to_tpp_point(point));
+    }
+  };
+  if (const auto *point = std::get_if<Point>(&site)) {
+    result.push_back(to_tpp_point(*point));
+  } else if (const auto *ring = std::get_if<Ring>(&site)) {
+    append_ring(*ring);
+  } else if (const auto *polygon = std::get_if<Polygon>(&site)) {
+    append_ring(polygon->outer());
+  } else {
+    throw std::invalid_argument(
+        "The TPP oracle supports point and polygonal path sites only.");
+  }
+  if (result.empty()) {
+    throw std::invalid_argument("The TPP oracle received an empty site.");
+  }
+  return normalize_convex_polygon(std::move(result));
+}
